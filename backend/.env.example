# ============================================================
# KisanConnect Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Application environment: "development" | "production"
APP_ENV=development

# Secret key for JWT signing — change this in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# JWT algorithm and token expiry (seconds)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# OTP configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================
# SMS Provider: "mock" | "fast2sms" | "twilio" | "msg91"
# Use "mock" for local development (OTP printed to console)
# ============================================================
SMS_PROVIDER=mock

# --- Fast2SMS (https://www.fast2sms.com) ---
# Sign up, go to Developer API -> API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# --- Twilio (https://www.twilio.com) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- MSG91 (https://msg91.com) ---
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=KISANC
MSG91_ROUTE=4
